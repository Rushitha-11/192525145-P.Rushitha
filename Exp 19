data <- data.frame(
  CustomerID = 1:10,
  Gender = c("Male","Male","Female","Female","Female",
             "Male","Female","Male","Female","Male"),
  Age = c(19,21,20,23,31,35,40,28,30,45),
  Income = c(15,15,16,16,17,30,35,40,50,60),
  Spending = c(39,81,6,77,40,60,20,75,90,30)
)
x <- data[, c("Income", "Spending")]
set.seed(123)
model <- kmeans(x, centers = 5, nstart = 25)
data$Cluster <- model$cluster
print(data)
plot(x$Income, x$Spending,
     col = data$Cluster, pch = 19,
     xlab = "Annual Income (k$)",
     ylab = "Spending Score",
     main = "Mall Customer Segmentation")
points(model$centers, col = 1:5, pch = 8, cex = 2)
