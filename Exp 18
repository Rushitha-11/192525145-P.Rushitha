age <- c(23,23,27,27,39,41,47,49,50,52,54,54,56,57,58,58,60,61)
x <- 35
minmax <- (x - min(age)) / (max(age) - min(age))
zscore <- (x - mean(age)) / 12.94
decimal <- x / 100
cat("Min-Max Normalization =", round(minmax, 4), "\n")
cat("Z-score Normalization =", round(zscore, 4), "\n")
cat("Decimal Scaling =", decimal)
