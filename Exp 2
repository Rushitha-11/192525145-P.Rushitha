good_prob <- 0.45
bad_prob <- 0.55
expansion_cost <- 2
no_expand_good <- 4
no_expand_bad <- 1.5
expand_good <- 7 - expansion_cost
expand_bad <- 3 - expansion_cost
emv_no_expand <- (good_prob * no_expand_good) + (bad_prob * no_expand_bad)
emv_expand <- (good_prob * expand_good) + (bad_prob * expand_bad)
cat("DECISION TREE ANALYSIS\n\n")
cat("No Expansion:\n")
cat("Good Economy =", no_expand_good, "M\n")
cat("Bad Economy  =", no_expand_bad, "M\n")
cat("EMV =", emv_no_expand, "M\n\n")
cat("Expansion:\n")
cat("Good Economy =", expand_good, "M\n")
cat("Bad Economy  =", expand_bad, "M\n")
cat("EMV =", emv_expand, "M\n\n")
if(emv_expand > emv_no_expand) {
  cat("Best Decision: EXPAND THE FACTORY\n")
  cat("Maximum EMV =", emv_expand, "M\n")
} else {
  cat("Best Decision: DO NOT EXPAND THE FACTORY\n")
  cat("Maximum EMV =", emv_no_expand, "M\n")
}
plot.new()
plot.window(xlim = c(0, 10), ylim = c(0, 10))
title("Decision Tree for Factory Expansion")
text(1, 5, "Decision", cex = 1.2)
segments(1.3, 5, 3, 7)
segments(1.3, 5, 3, 3)
text(2.1, 6.3, "Expand")
text(2.1, 3.7, "No Expansion")
