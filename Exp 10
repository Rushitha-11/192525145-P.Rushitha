install.packages("HSAUR3")

library(HSAUR3)

data(water)

plot(water$hardness,water$mortality,
     main="Mortality vs Hardness",
     xlab="Hardness",
     ylab="Mortality",
     pch=19)

model<-lm(mortality~hardness,data=water)

abline(model,lwd=2)

summary(model)

prediction<-predict(model,newdata=data.frame(hardness=88))

prediction
